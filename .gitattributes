# Normalize line endings for text files
* text=auto

# Source files: LF on commit
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.rs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf

# Binary artifacts must never be line-ending or merge normalized
*.wasm binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
