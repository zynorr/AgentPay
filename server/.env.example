# Copy this file to server/.env and fill in the values.
# The one-shot bootstrap (npm run setup) generates a real .env automatically.

# Address that receives payments (testnet)
STELLAR_RECIPIENT=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Recipient secret key, used only to record payments on-chain
STELLAR_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Keypair the CLI demo agent pays from
AGENT_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Deployed PaymentRegistry contract id
CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# HMAC secret that binds MPP challenge ids
MPP_SECRET_KEY=change-me-to-a-random-string

# mock or openai (OpenAI-compatible endpoint)
AI_PROVIDER=mock

# Provider credentials (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
# GROQ_API_KEY=  # alias; one is enough

# Provider base URL and model
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_MAX_TOKENS=300
OPENAI_TEMPERATURE=0.7

# Per-request price
PRICE_XLM=0.05

# Service
PORT=4000
CORS_ORIGIN=http://localhost:5173
